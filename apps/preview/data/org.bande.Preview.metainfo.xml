<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.bande.Preview</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Preview</name>
  <summary>View images</summary>
  <description>
    <p>Opens PNG, JPEG, GIF, WebP and SVG pictures from Files, zooms, pans, rotates and flips them, steps through a folder, plays animations and slideshows, copies them and shows their size, dimensions and camera details.</p>
  </description>
  <developer id="org.bande">
    <name>Bande</name>
  </developer>
  <launchable type="desktop-id">org.bande.Preview.desktop</launchable>
  <url type="homepage">https://github.com/bande-linux/apps</url>
  <provides>
    <mediatype>image/png</mediatype>
    <mediatype>image/jpeg</mediatype>
    <mediatype>image/gif</mediatype>
    <mediatype>image/webp</mediatype>
    <mediatype>image/svg+xml</mediatype>
  </provides>
</component>
