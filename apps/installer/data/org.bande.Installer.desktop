[Desktop Entry]
Type=Application
Name=Package Installer
Name[sv]=Paketinstallation
Comment=Install software packages from files
Comment[sv]=Installera programvarupaket från filer
Icon=org.bande.Installer
Exec=bande-installer %f
StartupNotify=true
NoDisplay=true
MimeType=application/vnd.debian.binary-package;application/x-deb;
Categories=System;PackageManager;
