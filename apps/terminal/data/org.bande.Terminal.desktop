[Desktop Entry]
Type=Application
Name=Terminal
Name[sv]=Terminal
GenericName=Terminal Emulator
GenericName[sv]=Terminalemulator
Comment=Use the command line
Comment[sv]=Använd kommandoraden
Icon=org.bande.Terminal
