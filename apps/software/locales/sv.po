msgstr "{status} {percent} %"

msgid "Couldn’t download {name}. Check your internet connection and try again."
msgstr "Det gick inte att hämta {name}. Kontrollera internetanslutningen och försök igen."

msgid "Another installation or update is running. Try again when it finishes."
msgstr "En annan installation eller uppdatering pågår. Försök igen när den är klar."

msgid "There isn’t enough disk space for {name}. Free up some space and try again."
msgstr "Det finns inte tillräckligt med diskutrymme för {name}. Frigör utrymme och försök igen."

msgid "{name} isn’t in the package lists any more. Check for updates in Software Update to refresh them, then try again."
msgstr "{name} finns inte längre i paketlistorna. Sök efter uppdateringar i Programuppdatering för att uppdatera dem och försök sedan igen."

msgid "{name} needs packages that can’t be installed right now. Install pending updates in Software Update, then try again."
msgstr "{name} kräver paket som inte kan installeras just nu. Installera väntande uppdateringar i Programuppdatering och försök sedan igen."

msgid "{name} is part of the system and can’t be removed."
msgstr "{name} är en del av systemet och kan inte tas bort."

msgid "{name} isn’t signed by a trusted source, so it wasn’t installed."
msgstr "{name} är inte signerat av en betrodd källa och installerades därför inte."

msgid "Nothing was changed, because no administrator’s password was given. If no password window appeared, log out and back in, then try again."
msgstr "Inget ändrades, eftersom inget administratörslösenord angavs. Om inget lösenordsfönster visades, logga ut och in igen och försök sedan igen."

msgid "Installing apps needs PackageKit, which isn’t installed."
msgstr "För att installera appar behövs PackageKit, som inte är installerat."

msgid "This app needs X11, which Bande doesn’t run."
msgstr "Den här appen kräver X11, som Bande inte kör."

msgid "Couldn’t install {name}."
msgstr "Det gick inte att installera {name}."

msgid "Couldn’t remove {name}."
msgstr "Det gick inte att ta bort {name}."

